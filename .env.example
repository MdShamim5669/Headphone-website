# Site origin used in payment redirect URLs (set to your real domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe Checkout (card payments). Leave empty → demo mode ---
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# --- SSLCommerz (Bangladesh: bKash, Nagad, Rocket, cards). Leave empty → demo mode ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=0            # 1 = live (securepay), 0 = sandbox
SSLCOMMERZ_CURRENCY=BDT      # BDT or USD
BDT_PER_USD=120              # conversion used when currency is BDT

# Set to 1 to hide Cash on delivery
CHECKOUT_DISABLE_COD=0
